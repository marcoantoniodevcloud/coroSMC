<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout android:id="@+id/parentView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.garethevans.church.opensongtablet.customviews.ScrollViewWithFAB
        android:id="@+id/lyricsScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:focusable="false"
        android:focusableInTouchMode="false">

        <RelativeLayout
            android:id="@+id/resizeForKeyboardLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:paddingBottom="@dimen/extra_scroll_space_large">

            <com.garethevans.church.opensongtablet.customviews.MyMaterialButton
                android:id="@+id/ocr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:text="@string/text_extract"
                android:visibility="gone"
                app:icon="@drawable/ocr"
                app:iconTint="@color/white" />

            <com.garethevans.church.opensongtablet.customviews.MyMaterialButton
                android:id="@+id/imageEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/ocr"
                android:text="@string/image_adjust"
                android:visibility="gone"
                app:icon="@drawable/crop_rotate"
                app:iconTint="@color/white" />

            <LinearLayout
                android:id="@+id/lyricsActions"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_below="@+id/imageEdit"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/redoButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/next"
                    android:padding="10dp"
                    android:src="@drawable/redo"
                    app:tint="?attr/colorOnSurface" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/undoButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/back"
                    android:padding="10dp"
                    android:src="@drawable/undo"
                    app:tint="?attr/colorOnSurface" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/copyLyricsButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/copy_of"
                    android:padding="10dp"
                    android:src="@drawable/copy_text"
                    app:tint="?attr/colorOnSurface" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/pasteLyricsButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/paste"
                    android:padding="10dp"
                    android:src="@drawable/paste_text"
                    app:tint="?attr/colorOnSurface" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/replaceLyricsButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/replace_all"
                    android:padding="10dp"
                    android:src="@drawable/file_replace"
                    app:tint="?attr/colorOnSurface" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/settingsButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/extra_settings"
                    android:padding="10dp"
                    android:src="@drawable/menu"
                    app:tint="?attr/colorOnSurface" />
            </LinearLayout>

            <com.garethevans.church.opensongtablet.customviews.MyMaterialEditText
                android:id="@+id/lyrics"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/lyricsActions"
                android:layout_marginBottom="72dp"
                android:hint="@string/lyrics"
                android:inputType="text|textMultiLine"
                android:minLines="25"
                app:autoSizeMaxTextSize="18sp"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeStepGranularity="2sp"
                app:autoSizeTextType="uniform"
                app:useMonospace="true" />

            <ImageView
                android:id="@+id/previewImage"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_below="@+id/lyrics"
                android:layout_centerHorizontal="true"
                android:visibility="visible"
                android:contentDescription="@string/image" />
        </RelativeLayout>
    </com.garethevans.church.opensongtablet.customviews.ScrollViewWithFAB>

</androidx.coordinatorlayout.widget.CoordinatorLayout>